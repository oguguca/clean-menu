<UserControl x:Class="CleanMenu.UI.Controls.PageHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
  <!-- Every page starts with its name and one plain sentence saying what it is for. -->
  <StackPanel>
    <TextBlock Text="{Binding Title, ElementName=Root}" Style="{StaticResource Text.PageTitle}" />
    <TextBlock Text="{Binding Description, ElementName=Root}" Style="{StaticResource Text.Secondary}"
               Margin="0,6,0,0" MaxWidth="720" HorizontalAlignment="Left" />
  </StackPanel>
</UserControl>
