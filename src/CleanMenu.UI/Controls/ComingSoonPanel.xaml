<UserControl x:Class="CleanMenu.UI.Controls.ComingSoonPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:CleanMenu.UI"
             x:Name="Root">
  <!-- Honest placeholder: says the area is not ready and lists, in plain words, what it will do. -->
  <Border Style="{StaticResource Card}" Padding="28" MaxWidth="760" HorizontalAlignment="Left">
    <StackPanel>
      <StackPanel Orientation="Horizontal">
        <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Brush.AccentSubtle}">
          <TextBlock Text="{x:Static ui:Glyphs.Repair}" Style="{StaticResource Text.Icon}" FontSize="18"
                     HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
        </Border>
        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock Text="Esta área ainda está em construção" Style="{StaticResource Text.CardTitle}" />
          <TextBlock Text="{Binding Note, ElementName=Root}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
        </StackPanel>
      </StackPanel>

      <TextBlock Text="Quando estiver pronta, aqui você vai poder:" Style="{StaticResource Text.Body}" Margin="0,22,0,10" />

      <ItemsControl ItemsSource="{Binding Features, ElementName=Root}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="0,5">
              <TextBlock Text="{x:Static ui:Glyphs.CheckMark}" Style="{StaticResource Text.Icon}" FontSize="13"
                         Foreground="{DynamicResource Brush.Accent}" Margin="0,3,12,0" VerticalAlignment="Top" />
              <TextBlock Text="{Binding}" Style="{StaticResource Text.Secondary}" />
            </DockPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </Border>
</UserControl>
