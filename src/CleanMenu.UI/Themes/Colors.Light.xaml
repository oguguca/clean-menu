<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Light theme. Every brush key must also exist in Colors.Dark.xaml. -->
  <SolidColorBrush x:Key="Brush.Background" Color="#F3F4F7" />
  <SolidColorBrush x:Key="Brush.Sidebar" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.CardHover" Color="#F0F2F5" />
  <SolidColorBrush x:Key="Brush.Border" Color="#DFE2E8" />
  <SolidColorBrush x:Key="Brush.Track" Color="#E4E7EC" />

  <SolidColorBrush x:Key="Brush.Text" Color="#15181E" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#4B5260" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#6E7583" />

  <SolidColorBrush x:Key="Brush.Accent" Color="#1E8F67" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#23A174" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#197A58" />
  <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#E2F4EC" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />

  <SolidColorBrush x:Key="Brush.Good" Color="#1E8F67" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#B7791F" />
  <SolidColorBrush x:Key="Brush.Critical" Color="#C8402F" />
  <SolidColorBrush x:Key="Brush.Neutral" Color="#6E7583" />

  <SolidColorBrush x:Key="Brush.Disabled" Color="#E4E7EC" />
  <SolidColorBrush x:Key="Brush.DisabledText" Color="#8A909C" />
  <SolidColorBrush x:Key="Brush.Focus" Color="#15181E" />
</ResourceDictionary>
