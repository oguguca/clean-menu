<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Light theme. Every brush key must also exist in Colors.Dark.xaml. -->
  <SolidColorBrush x:Key="Brush.Background" Color="#F2F6FD" />
  <SolidColorBrush x:Key="Brush.Sidebar" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Card" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.CardHover" Color="#EBF1FC" />
  <SolidColorBrush x:Key="Brush.Border" Color="#D6E0F2" />
  <SolidColorBrush x:Key="Brush.Track" Color="#DFE7F5" />

  <SolidColorBrush x:Key="Brush.Text" Color="#0B1530" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#3F4D70" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#5F6C8C" />

  <SolidColorBrush x:Key="Brush.Accent" Color="#0F62D6" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#1A72EC" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#0B52B5" />
  <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#E1ECFD" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />

  <SolidColorBrush x:Key="Brush.Good" Color="#1E8F67" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#B7791F" />
  <SolidColorBrush x:Key="Brush.Critical" Color="#C8402F" />
  <SolidColorBrush x:Key="Brush.Neutral" Color="#5F6C8C" />

  <SolidColorBrush x:Key="Brush.Disabled" Color="#E2E8F3" />
  <SolidColorBrush x:Key="Brush.DisabledText" Color="#8590A8" />
  <SolidColorBrush x:Key="Brush.Focus" Color="#0B1530" />
</ResourceDictionary>
