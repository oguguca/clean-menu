<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Dark theme (default). Every brush key must also exist in Colors.Light.xaml. -->
  <SolidColorBrush x:Key="Brush.Background" Color="#060B1A" />
  <SolidColorBrush x:Key="Brush.Sidebar" Color="#081130" />
  <SolidColorBrush x:Key="Brush.Card" Color="#0D1836" />
  <SolidColorBrush x:Key="Brush.CardHover" Color="#13214A" />
  <SolidColorBrush x:Key="Brush.Border" Color="#1C2D5C" />
  <SolidColorBrush x:Key="Brush.Hairline" Color="#24FFFFFF" />
  <SolidColorBrush x:Key="Brush.Fill" Color="#1A2A52" />
  <SolidColorBrush x:Key="Brush.FillHover" Color="#22356A" />
  <SolidColorBrush x:Key="Brush.Track" Color="#1C2D5C" />

  <SolidColorBrush x:Key="Brush.Text" Color="#EEF3FF" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A7B4D6" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#7C8AB2" />

  <SolidColorBrush x:Key="Brush.Accent" Color="#3B95FF" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#5AA8FF" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#2479E6" />
  <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#102A5C" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="#04122B" />

  <SolidColorBrush x:Key="Brush.Good" Color="#3FC58F" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#E3A63B" />
  <SolidColorBrush x:Key="Brush.Critical" Color="#E5604F" />
  <SolidColorBrush x:Key="Brush.Neutral" Color="#7C8AB2" />

  <SolidColorBrush x:Key="Brush.Disabled" Color="#142147" />
  <SolidColorBrush x:Key="Brush.DisabledText" Color="#64739A" />
  <SolidColorBrush x:Key="Brush.Focus" Color="#EEF3FF" />
</ResourceDictionary>
