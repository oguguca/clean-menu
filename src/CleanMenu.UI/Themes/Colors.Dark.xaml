<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Dark theme (default). Every brush key must also exist in Colors.Light.xaml. -->
  <SolidColorBrush x:Key="Brush.Background" Color="#111318" />
  <SolidColorBrush x:Key="Brush.Sidebar" Color="#15181E" />
  <SolidColorBrush x:Key="Brush.Card" Color="#1B1F27" />
  <SolidColorBrush x:Key="Brush.CardHover" Color="#222733" />
  <SolidColorBrush x:Key="Brush.Border" Color="#2A303C" />
  <SolidColorBrush x:Key="Brush.Track" Color="#2A303C" />

  <SolidColorBrush x:Key="Brush.Text" Color="#EEF0F4" />
  <SolidColorBrush x:Key="Brush.TextSecondary" Color="#A9AFBC" />
  <SolidColorBrush x:Key="Brush.TextMuted" Color="#7C8391" />

  <SolidColorBrush x:Key="Brush.Accent" Color="#3FB68B" />
  <SolidColorBrush x:Key="Brush.AccentHover" Color="#52C79C" />
  <SolidColorBrush x:Key="Brush.AccentPressed" Color="#33A07A" />
  <SolidColorBrush x:Key="Brush.AccentSubtle" Color="#1A3A30" />
  <SolidColorBrush x:Key="Brush.OnAccent" Color="#08190F" />

  <SolidColorBrush x:Key="Brush.Good" Color="#3FB68B" />
  <SolidColorBrush x:Key="Brush.Warning" Color="#E3A63B" />
  <SolidColorBrush x:Key="Brush.Critical" Color="#E5604F" />
  <SolidColorBrush x:Key="Brush.Neutral" Color="#7C8391" />

  <SolidColorBrush x:Key="Brush.Disabled" Color="#262B35" />
  <SolidColorBrush x:Key="Brush.DisabledText" Color="#6B7280" />
  <SolidColorBrush x:Key="Brush.Focus" Color="#EEF0F4" />
</ResourceDictionary>
