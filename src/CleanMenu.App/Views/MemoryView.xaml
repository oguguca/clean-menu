<UserControl x:Class="CleanMenu.App.Views.MemoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CleanMenu.UI.Controls;assembly=CleanMenu.UI"
             xmlns:ui="clr-namespace:CleanMenu.UI;assembly=CleanMenu.UI"
             xmlns:vm="clr-namespace:CleanMenu.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MemoryViewModel}"
             Style="{StaticResource Page.Root}">
  <StackPanel>
    <controls:PageHeader Title="{Binding Title}" Description="{Binding Description}" />

    <!-- ===== Current usage ===== -->
    <Border Style="{StaticResource Card}" Margin="0,28,14,0" Padding="28">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Width="150" Height="150" VerticalAlignment="Top">
          <controls:RingGauge Value="{Binding UsedPercent}" Thickness="12" Style="{StaticResource StatusRing}" />
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding UsedPercentText}" Style="{StaticResource Text.Value}" FontSize="30" HorizontalAlignment="Center" />
            <TextBlock Text="em uso" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>

        <StackPanel Grid.Column="1" Margin="32,0,0,0">
          <StackPanel Orientation="Horizontal">
            <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
          </StackPanel>

          <UniformGrid Columns="4" Margin="0,20,0,0">
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="Total" Style="{StaticResource Fact.Label}" />
              <TextBlock Text="{Binding TotalText}" Style="{StaticResource Fact.Value}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
              <TextBlock Text="Em uso" Style="{StaticResource Fact.Label}" />
              <TextBlock Text="{Binding UsedText}" Style="{StaticResource Fact.Value}" />
            </StackPanel>
            <StackPanel Margin="0,0,12,0">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Disponível" Style="{StaticResource Fact.Label}" VerticalAlignment="Center" />
                <controls:InfoTip Margin="4,0,0,0" Text="Memória que pode ser entregue a um programa agora. Inclui um cache que o Windows guarda para abrir programas mais rápido e libera sozinho quando precisa." />
              </StackPanel>
              <TextBlock Text="{Binding AvailableText}" Style="{StaticResource Fact.Value}" />
            </StackPanel>
            <StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Reservada" Style="{StaticResource Fact.Label}" VerticalAlignment="Center" />
                <controls:InfoTip Margin="4,0,0,0" Text="Parte da memória instalada que fica separada para o hardware (por exemplo, o vídeo integrado) e não aparece para os programas." />
              </StackPanel>
              <TextBlock Text="{Binding ReservedText}" Style="{StaticResource Fact.Value}" TextWrapping="Wrap" />
            </StackPanel>
          </UniformGrid>

          <TextBlock Text="Uso nos últimos 2 minutos" Style="{StaticResource Text.Caption}" Margin="0,4,0,8" />
          <controls:Sparkline Values="{Binding History}" Height="56" Stroke="{DynamicResource Brush.Accent}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===== Evidence-based growth warnings ===== -->
    <Border Style="{StaticResource Callout.Warning}" Margin="0,20,14,0"
            Visibility="{Binding GrowthWarnings.Count, Converter={StaticResource HasValue}}">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{x:Static ui:Glyphs.Warning}" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,10,0" />
          <TextBlock Text="Programas com uso de memória sempre crescendo" Style="{StaticResource Text.CardTitle}" />
        </StackPanel>
        <ItemsControl ItemsSource="{Binding GrowthWarnings}" Margin="0,10,0,0" Focusable="False">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding}" Style="{StaticResource Text.Secondary}" Margin="0,4" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

    <!-- ===== Top processes ===== -->
    <DockPanel Margin="0,32,14,4">
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Command="{Binding OpenTaskManagerCommand}"
              ToolTip="Abre o Gerenciador de Tarefas do Windows, onde você pode fechar programas.">
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{x:Static ui:Glyphs.OpenExternal}" Style="{StaticResource Text.Icon}" FontSize="14" Margin="0,0,8,0" />
          <TextBlock Text="Abrir Gerenciador de Tarefas" />
        </StackPanel>
      </Button>
      <TextBlock Text="Programas que mais usam memória" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center" />
    </DockPanel>
    <TextBlock Text="Para liberar memória, feche os programas abertos por você que não estiver usando. Os do Windows devem ficar abertos."
               Style="{StaticResource Text.Caption}" Margin="0,0,14,14" />
    <TextBlock Text="{Binding ActionMessage}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Warning}"
               Visibility="{Binding ActionMessage, Converter={StaticResource HasValue}}" Margin="0,0,0,10" />

    <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="8">
      <ItemsControl ItemsSource="{Binding TopProcesses}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:ProgramRowViewModel}">
            <Grid Margin="12,10">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="170" />
                <ColumnDefinition Width="110" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Advice}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
              </StackPanel>
              <Border Grid.Column="1" Style="{StaticResource Tag.Border}" HorizontalAlignment="Left">
                <TextBlock Text="{Binding KindText}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
              </Border>
              <TextBlock Grid.Column="2" Text="{Binding MemoryText}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- ===== Honest explanation ===== -->
    <Border Style="{StaticResource Card}" Margin="0,20,14,0">
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="{x:Static ui:Glyphs.Info}" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0" />
          <TextBlock Text="Por que não existe um botão para &quot;limpar a memória&quot;?" Style="{StaticResource Text.CardTitle}" />
        </StackPanel>
        <TextBlock Text="{Binding NoFreeButtonExplanation}" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0" />
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
