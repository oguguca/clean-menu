<Window x:Class="CleanMenu.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:CleanMenu.UI;assembly=CleanMenu.UI"
        Title="Confirmar"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Text}"
        FontSize="14"
        UseLayoutRounding="True">
  <StackPanel Margin="28,24,28,24">
    <StackPanel Orientation="Horizontal">
      <TextBlock Text="{x:Static ui:Glyphs.Warning}" Style="{StaticResource Text.Icon}" FontSize="20"
                 Foreground="{DynamicResource Brush.Warning}" Margin="0,0,12,0" />
      <TextBlock x:Name="TitleText" Style="{StaticResource Text.SectionTitle}" TextWrapping="Wrap" MaxWidth="420" />
    </StackPanel>

    <TextBlock x:Name="MessageText" Style="{StaticResource Text.Body}" Margin="0,16,0,0" />

    <ItemsControl x:Name="DetailsList" Margin="0,12,0,0" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="0,3">
            <TextBlock Text="•" Margin="4,0,10,0" Foreground="{DynamicResource Brush.TextSecondary}" />
            <TextBlock Text="{Binding}" Style="{StaticResource Text.Secondary}" FontSize="14" />
          </DockPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
      <Button x:Name="CancelButton" Content="Cancelar" Style="{StaticResource Button.Secondary}" IsCancel="True"
              IsDefault="True" Margin="0,0,10,0" Click="OnCancel" />
      <Button x:Name="ConfirmButton" Style="{StaticResource Button.Primary}" Padding="22,10" Click="OnConfirm" />
    </StackPanel>
  </StackPanel>
</Window>
