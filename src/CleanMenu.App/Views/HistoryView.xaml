<UserControl x:Class="CleanMenu.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CleanMenu.UI.Controls;assembly=CleanMenu.UI"
             xmlns:vm="clr-namespace:CleanMenu.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:HistoryViewModel}"
             Style="{StaticResource Page.Root}">
  <StackPanel>
    <controls:PageHeader Title="{Binding Title}" Description="{Binding Description}" />

    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" Margin="0,28,14,16" />

    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:HistoryRowViewModel}">
          <Border Style="{StaticResource Card}" Margin="0,0,14,10" Padding="18,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Ellipse Style="{StaticResource StatusDot}" VerticalAlignment="Top" Margin="0,6,14,0" />
              <StackPanel Grid.Column="1" Margin="0,0,16,0">
                <TextBlock Text="{Binding Type}" Style="{StaticResource Text.CardTitle}" />
                <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Body}" FontSize="14" Margin="0,4,0,0" />
                <TextBlock Text="{Binding Categories}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                           Visibility="{Binding Categories, Converter={StaticResource HasValue}}" />
                <TextBlock Text="{Binding Errors}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" Foreground="{DynamicResource Brush.Warning}"
                           Visibility="{Binding Errors, Converter={StaticResource HasValue}}" />
              </StackPanel>
              <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                <TextBlock Text="{Binding When}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" />
                <TextBlock Text="{Binding Result}" Style="{StaticResource Text.Caption}" HorizontalAlignment="Right" Margin="0,4,0,0" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
