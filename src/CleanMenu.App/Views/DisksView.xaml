<UserControl x:Class="CleanMenu.App.Views.DisksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CleanMenu.UI.Controls;assembly=CleanMenu.UI"
             xmlns:ui="clr-namespace:CleanMenu.UI;assembly=CleanMenu.UI"
             xmlns:vm="clr-namespace:CleanMenu.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DisksViewModel}"
             x:Name="Root"
             Style="{StaticResource Page.Root}">
  <StackPanel>
    <controls:PageHeader Title="{Binding Title}" Description="{Binding Description}" />

    <DockPanel Margin="0,28,14,14">
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}">
        <TextBlock Text="Atualizar" />
      </Button>
      <TextBlock Text="Unidades" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center" />
    </DockPanel>
    <Border Margin="0,0,14,14" Padding="14,12" CornerRadius="8" Background="{DynamicResource Brush.AccentSubtle}"
            Visibility="{Binding Message, Converter={StaticResource HasValue}}">
      <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" />
    </Border>
    <ItemsControl ItemsSource="{Binding Volumes}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:VolumeRowViewModel}">
          <Border Style="{StaticResource Card}" Margin="0,0,14,14">
            <StackPanel>
              <DockPanel>
                <TextBlock Text="{x:Static ui:Glyphs.HardDrive}" Style="{StaticResource Text.Icon}" Margin="0,0,10,0"
                           Foreground="{DynamicResource Brush.TextSecondary}" />
                <TextBlock Text="{Binding FreeText}" DockPanel.Dock="Right" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.CardTitle}" />
              </DockPanel>
              <controls:UsageBar Value="{Binding UsedPercent}" Style="{StaticResource StatusUsageBar}" Margin="0,12,0,8" />
              <TextBlock Text="{Binding DetailText}" Style="{StaticResource Text.Caption}" />
              <TextBlock Text="{Binding Advice}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0" />
              <TextBlock Text="{Binding OptimizeExplanation}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0"
                         Foreground="{DynamicResource Brush.TextMuted}" />
              <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Style="{StaticResource Button.Secondary}" Margin="0,0,8,0"
                        Command="{Binding DataContext.OptimizeCommand, ElementName=Root}" CommandParameter="{Binding}"
                        ToolTip="Usa a ferramenta do Windows que escolhe TRIM (SSD) ou desfragmentação (HD).">
                  <TextBlock Text="Otimizar" />
                </Button>
                <Button Style="{StaticResource Button.Ghost}" Margin="0,0,8,0"
                        Command="{Binding DataContext.AnalyzeCommand, ElementName=Root}" CommandParameter="{Binding}">
                  <TextBlock Text="Analisar fragmentação" />
                </Button>
                <Button Style="{StaticResource Button.Ghost}"
                        Command="{Binding DataContext.CheckCommand, ElementName=Root}" CommandParameter="{Binding}">
                  <TextBlock Text="Verificar erros" />
                </Button>
              </StackPanel>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <StackPanel Orientation="Horizontal" Margin="0,22,0,4">
      <TextBlock Text="Discos instalados" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center" />
      <controls:InfoTip Margin="8,0,0,0" VerticalAlignment="Center"
                        Text="Um disco pode ter várias unidades (C:, D:…). Aqui aparecem as peças físicas. O estado mostrado é o que o próprio Windows informa: sem dados de diagnóstico, o Clean Menu não afirma que o disco está saudável." />
    </StackPanel>
    <TextBlock Text="Lendo os discos…" Style="{StaticResource Text.Caption}" Margin="0,4,0,0"
               Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />

    <ItemsControl ItemsSource="{Binding PhysicalDisks}" Margin="0,10,0,0" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:PhysicalDiskRowViewModel}">
          <Border Style="{StaticResource Card}" Margin="0,0,14,14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border Width="40" Height="40" CornerRadius="20" Background="{DynamicResource Brush.AccentSubtle}" VerticalAlignment="Top">
                <TextBlock Text="{x:Static ui:Glyphs.HardDrive}" Style="{StaticResource Text.Icon}" FontSize="18"
                           HorizontalAlignment="Center" Foreground="{DynamicResource Brush.Accent}" />
              </Border>
              <StackPanel Grid.Column="1" Margin="16,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Title}" Style="{StaticResource Text.CardTitle}" />
                  <Border Style="{StaticResource Tag.Border}" Margin="10,0,0,0">
                    <TextBlock Text="{Binding TypeText}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding Details}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Ellipse Style="{StaticResource StatusDot}" Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding HealthText}" Style="{StaticResource Text.Body}" FontSize="14" />
                </StackPanel>
                <TextBlock Text="{Binding TypeExplanation}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" />
              </StackPanel>
            </Grid>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

  </StackPanel>
</UserControl>
