<UserControl x:Class="CleanMenu.App.Views.OptimizationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CleanMenu.UI.Controls;assembly=CleanMenu.UI"
             xmlns:ui="clr-namespace:CleanMenu.UI;assembly=CleanMenu.UI"
             xmlns:vm="clr-namespace:CleanMenu.App.ViewModels"
             xmlns:m="clr-namespace:CleanMenu.Core.Maintenance;assembly=CleanMenu.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OptimizationViewModel}"
             x:Name="Root"
             Style="{StaticResource Page.Root}">
  <StackPanel>
    <controls:PageHeader Title="{Binding Title}" Description="{Binding Description}" />

    <Border Margin="0,20,14,0" Padding="14,12" CornerRadius="8" Background="{DynamicResource Brush.AccentSubtle}"
            Visibility="{Binding Message, Converter={StaticResource HasValue}}">
      <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" />
    </Border>

    <!-- ===== Energy ===== -->
    <StackPanel Orientation="Horizontal" Margin="0,28,0,4">
      <TextBlock Text="Plano de energia" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center" />
      <controls:InfoTip Margin="8,0,0,0" Text="Define o equilíbrio entre desempenho e consumo de energia. Trocar de plano é seguro e pode ser desfeito a qualquer momento." />
    </StackPanel>
    <TextBlock Text="O plano em uso aparece marcado." Style="{StaticResource Text.Caption}" Margin="0,0,0,12" />
    <ItemsControl ItemsSource="{Binding PowerPlans}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type m:PowerPlan}">
          <Border Style="{StaticResource Card}" Margin="0,0,14,10" Padding="18,14">
            <DockPanel>
              <Button DockPanel.Dock="Right" VerticalAlignment="Center"
                      Command="{Binding DataContext.ActivatePlanCommand, ElementName=Root}" CommandParameter="{Binding}">
                <Button.Style>
                  <Style TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsActive}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Button.Style>
                <TextBlock Text="Usar este" />
              </Button>
              <Border DockPanel.Dock="Right" Style="{StaticResource Tag.Border}" BorderBrush="{DynamicResource Brush.Accent}"
                      Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Em uso" FontSize="12" Foreground="{DynamicResource Brush.Accent}" />
              </Border>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{Binding Name}" Style="{StaticResource Text.CardTitle}" />
                <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Caption}" FontSize="14" Margin="0,4,0,0" />
              </StackPanel>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Command="{Binding OpenVisualEffectsCommand}"
            ToolTip="Abre a janela do Windows onde você pode desligar animações e sombras para ganhar desempenho em computadores mais fracos.">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{x:Static ui:Glyphs.OpenExternal}" Style="{StaticResource Text.Icon}" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Accent}" />
        <TextBlock Text="Abrir efeitos visuais do Windows" Foreground="{DynamicResource Brush.Accent}" />
      </StackPanel>
    </Button>

    <!-- ===== Privacy and background ===== -->
    <TextBlock Text="Privacidade e segundo plano" Style="{StaticResource Text.SectionTitle}" Margin="0,28,0,4" />
    <TextBlock Text="O Clean Menu mostra como está cada opção. Para mudar, ele abre a tela certa das Configurações do Windows."
               Style="{StaticResource Text.Caption}" Margin="0,0,14,12" />
    <ItemsControl ItemsSource="{Binding Settings}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type m:WindowsSettingInfo}">
          <Border Style="{StaticResource Card}" Margin="0,0,14,10" Padding="18,14">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" VerticalAlignment="Center"
                      Command="{Binding DataContext.OpenSettingCommand, ElementName=Root}" CommandParameter="{Binding}">
                <TextBlock Text="Abrir configuração" />
              </Button>
              <StackPanel Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Title}" Style="{StaticResource Text.CardTitle}" />
                  <Border Style="{StaticResource Tag.Border}" Margin="10,0,0,0">
                    <TextBlock Text="{Binding CurrentValue}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                  </Border>
                </StackPanel>
                <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Caption}" FontSize="14" Margin="0,4,0,0" />
              </StackPanel>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- ===== Maintenance ===== -->
    <ItemsControl ItemsSource="{Binding ToolGroups}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:MaintenanceToolGroup}">
          <StackPanel>
            <TextBlock Text="{Binding Title}" Style="{StaticResource Text.SectionTitle}" Margin="0,28,0,4" />
            <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" Margin="0,0,14,12" />
            <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:MaintenanceToolItem}">
                  <Border Style="{StaticResource Card}" Margin="0,0,14,14">
                    <DockPanel>
                      <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
                        <Button Style="{StaticResource Button.Secondary}" HorizontalAlignment="Left"
                                IsEnabled="{Binding IsAvailable}"
                                Command="{Binding DataContext.RunToolCommand, ElementName=Root}" CommandParameter="{Binding}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{x:Static ui:Glyphs.Repair}" Style="{StaticResource Text.Icon}" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Executar" />
                          </StackPanel>
                        </Button>
                        <TextBlock Text="{Binding UnavailableText}" Margin="0,6,0,0"
                                   Foreground="{DynamicResource Brush.Warning}">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                              <Setter Property="Visibility" Value="Collapsed" />
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                  <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                      </StackPanel>
                      <StackPanel>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource Text.CardTitle}" TextWrapping="Wrap" TextTrimming="None" />
                        <TextBlock Text="{Binding Explanation}" Style="{StaticResource Text.Caption}" FontSize="14" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding Duration}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0" Foreground="{DynamicResource Brush.TextMuted}" />
                      </StackPanel>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Command="{Binding OpenOutputFolderCommand}"
            ToolTip="{Binding OutputFolder}">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="{x:Static ui:Glyphs.OpenExternal}" Style="{StaticResource Text.Icon}" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource Brush.Accent}" />
        <TextBlock Text="Abrir a pasta com cópias e relatórios" Foreground="{DynamicResource Brush.Accent}" />
      </StackPanel>
    </Button>
  </StackPanel>
</UserControl>
