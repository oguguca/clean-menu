<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:CleanMenu.UI.Controls;assembly=CleanMenu.UI"
                    xmlns:ui="clr-namespace:CleanMenu.UI;assembly=CleanMenu.UI"
                    xmlns:vm="clr-namespace:CleanMenu.App.ViewModels"
                    xmlns:conv="clr-namespace:CleanMenu.UI.Converters;assembly=CleanMenu.UI">
  <!-- Templates shared by several pages. -->

  <conv:EnumEqualsConverter x:Key="EnumEquals" />
  <conv:HasValueToVisibilityConverter x:Key="HasValue" />
  <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

  <!-- Ring color follows the status. -->
  <Style x:Key="StatusRing" TargetType="controls:RingGauge">
    <Setter Property="TrackBrush" Value="{DynamicResource Brush.Track}" />
    <Setter Property="ValueBrush" Value="{DynamicResource Brush.Neutral}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static ui:StatusLevel.Good}">
        <Setter Property="ValueBrush" Value="{DynamicResource Brush.Good}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static ui:StatusLevel.Warning}">
        <Setter Property="ValueBrush" Value="{DynamicResource Brush.Warning}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static ui:StatusLevel.Critical}">
        <Setter Property="ValueBrush" Value="{DynamicResource Brush.Critical}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Small colored dot for a status. -->
  <Style x:Key="StatusDot" TargetType="Ellipse">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Fill" Value="{DynamicResource Brush.Neutral}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static ui:StatusLevel.Good}">
        <Setter Property="Fill" Value="{DynamicResource Brush.Good}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static ui:StatusLevel.Warning}">
        <Setter Property="Fill" Value="{DynamicResource Brush.Warning}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static ui:StatusLevel.Critical}">
        <Setter Property="Fill" Value="{DynamicResource Brush.Critical}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- A small outlined tag ("Avançado", "SSD", "Windows"). -->
  <Style x:Key="Tag.Border" TargetType="Border">
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Callout used for warnings. -->
  <Style x:Key="Callout.Warning" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Warning}" />
  </Style>

  <DataTemplate DataType="{x:Type vm:MetricCardViewModel}">
    <controls:StatCard Margin="0,0,14,14" Title="{Binding Title}" Glyph="{Binding Glyph}" Value="{Binding Value}"
                       Caption="{Binding Caption}" HelpText="{Binding HelpText}" Status="{Binding Status}"
                       History="{Binding History}" />
  </DataTemplate>

  <!-- Bar color follows the status: green / amber / red / gray. -->
  <Style x:Key="StatusUsageBar" TargetType="controls:UsageBar">
    <Setter Property="TrackBrush" Value="{DynamicResource Brush.Track}" />
    <Setter Property="FillBrush" Value="{DynamicResource Brush.Neutral}" />
    <Style.Triggers>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static ui:StatusLevel.Good}">
        <Setter Property="FillBrush" Value="{DynamicResource Brush.Good}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static ui:StatusLevel.Warning}">
        <Setter Property="FillBrush" Value="{DynamicResource Brush.Warning}" />
      </DataTrigger>
      <DataTrigger Binding="{Binding Status}" Value="{x:Static ui:StatusLevel.Critical}">
        <Setter Property="FillBrush" Value="{DynamicResource Brush.Critical}" />
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <DataTemplate DataType="{x:Type vm:VolumeRowViewModel}">
    <Border Style="{StaticResource Card}" Margin="0,0,14,14">
      <StackPanel>
        <DockPanel>
          <TextBlock Text="{x:Static ui:Glyphs.HardDrive}" Style="{StaticResource Text.Icon}" Margin="0,0,10,0"
                     Foreground="{DynamicResource Brush.TextSecondary}" />
          <TextBlock Text="{Binding FreeText}" DockPanel.Dock="Right" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Title}" Style="{StaticResource Text.CardTitle}" />
        </DockPanel>
        <controls:UsageBar Value="{Binding UsedPercent}" Style="{StaticResource StatusUsageBar}" Margin="0,12,0,8" />
        <TextBlock Text="{Binding DetailText}" Style="{StaticResource Text.Caption}" />
        <TextBlock Text="{Binding Advice}" Style="{StaticResource Text.Caption}" Margin="0,2,0,0"
                   Foreground="{DynamicResource Brush.TextSecondary}" />
      </StackPanel>
    </Border>
  </DataTemplate>

  <!-- A label/value pair used on information pages. -->
  <Style x:Key="Fact.Label" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}" />
  <Style x:Key="Fact.Value" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0,3,0,16" />
  </Style>
</ResourceDictionary>
