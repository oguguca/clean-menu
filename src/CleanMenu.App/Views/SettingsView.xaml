<UserControl x:Class="CleanMenu.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:controls="clr-namespace:CleanMenu.UI.Controls;assembly=CleanMenu.UI"
             xmlns:ui="clr-namespace:CleanMenu.UI;assembly=CleanMenu.UI"
             xmlns:vm="clr-namespace:CleanMenu.App.ViewModels"
             xmlns:s="clr-namespace:CleanMenu.Core.Settings;assembly=CleanMenu.Core"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             Style="{StaticResource Page.Root}">
  <UserControl.Resources>
    <Style x:Key="SettingRow" TargetType="Border" BasedOn="{StaticResource Card}">
      <Setter Property="Margin" Value="0,0,14,12" />
      <Setter Property="Padding" Value="20,16" />
    </Style>
  </UserControl.Resources>

  <StackPanel>
    <controls:PageHeader Title="{Binding Title}" Description="{Binding Description}" />

    <Border Margin="0,20,14,0" Padding="14,12" CornerRadius="8" Background="{DynamicResource Brush.AccentSubtle}"
            Visibility="{Binding NeedsRestart, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Text="Feche e abra o Clean Menu de novo para aplicar a mudança." Style="{StaticResource Text.Body}" />
    </Border>
    <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.Warning}" Margin="0,12,0,0"
               Visibility="{Binding Message, Converter={StaticResource HasValue}}" />

    <TextBlock Text="Aparência e sistema" Style="{StaticResource Text.SectionTitle}" Margin="0,24,0,12" />

    <Border Style="{StaticResource SettingRow}">
      <DockPanel>
        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource Segment}" Content="Escuro" GroupName="Theme"
                         IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static s:ThemePreference.Dark}}" />
            <RadioButton Style="{StaticResource Segment}" Content="Claro" GroupName="Theme"
                         IsChecked="{Binding Theme, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static s:ThemePreference.Light}}" />
          </StackPanel>
        </Border>
        <StackPanel Margin="0,0,16,0">
          <TextBlock Text="Tema" Style="{StaticResource Text.CardTitle}" />
          <TextBlock Text="Cores do Clean Menu. Muda na hora." Style="{StaticResource Text.Caption}" FontSize="14" Margin="0,4,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Style="{StaticResource SettingRow}">
      <DockPanel>
        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource Segment}" Content="Automático" GroupName="Os"
                         IsChecked="{Binding Os, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static s:OsPreference.Automatic}}" />
            <RadioButton Style="{StaticResource Segment}" Content="Windows 10" GroupName="Os"
                         IsChecked="{Binding Os, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static s:OsPreference.Windows10}}" />
            <RadioButton Style="{StaticResource Segment}" Content="Windows 11" GroupName="Os"
                         IsChecked="{Binding Os, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static s:OsPreference.Windows11}}" />
          </StackPanel>
        </Border>
        <StackPanel Margin="0,0,16,0">
          <TextBlock Text="Seu Windows" Style="{StaticResource Text.CardTitle}" />
          <TextBlock Style="{StaticResource Text.Caption}" FontSize="14" Margin="0,4,0,0"
                     Text="{Binding DetectedWindows, StringFormat='O Clean Menu mostra só as funções do sistema escolhido. Detectado: {0}.'}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <Border Style="{StaticResource SettingRow}">
      <DockPanel>
        <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal">
            <RadioButton Style="{StaticResource Segment}" Content="1 s" GroupName="Refresh">
              <RadioButton.IsChecked>
                <Binding Path="RefreshSeconds" Converter="{StaticResource EnumEquals}">
                  <Binding.ConverterParameter><sys:Int32>1</sys:Int32></Binding.ConverterParameter>
                </Binding>
              </RadioButton.IsChecked>
            </RadioButton>
            <RadioButton Style="{StaticResource Segment}" Content="2 s" GroupName="Refresh">
              <RadioButton.IsChecked>
                <Binding Path="RefreshSeconds" Converter="{StaticResource EnumEquals}">
                  <Binding.ConverterParameter><sys:Int32>2</sys:Int32></Binding.ConverterParameter>
                </Binding>
              </RadioButton.IsChecked>
            </RadioButton>
            <RadioButton Style="{StaticResource Segment}" Content="5 s" GroupName="Refresh">
              <RadioButton.IsChecked>
                <Binding Path="RefreshSeconds" Converter="{StaticResource EnumEquals}">
                  <Binding.ConverterParameter><sys:Int32>5</sys:Int32></Binding.ConverterParameter>
                </Binding>
              </RadioButton.IsChecked>
            </RadioButton>
            <RadioButton Style="{StaticResource Segment}" Content="10 s" GroupName="Refresh">
              <RadioButton.IsChecked>
                <Binding Path="RefreshSeconds" Converter="{StaticResource EnumEquals}">
                  <Binding.ConverterParameter><sys:Int32>10</sys:Int32></Binding.ConverterParameter>
                </Binding>
              </RadioButton.IsChecked>
            </RadioButton>
          </StackPanel>
        </Border>
        <StackPanel Margin="0,0,16,0">
          <TextBlock Text="Atualizar indicadores a cada" Style="{StaticResource Text.CardTitle}" />
          <TextBlock Text="Intervalos maiores usam menos o computador." Style="{StaticResource Text.Caption}" FontSize="14" Margin="0,4,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>

    <TextBlock Text="Comportamento" Style="{StaticResource Text.SectionTitle}" Margin="0,24,0,12" />

    <Border Style="{StaticResource SettingRow}">
      <StackPanel>
        <CheckBox Content="Abrir o Clean Menu quando o Windows iniciar" IsChecked="{Binding StartWithWindows}" />
        <CheckBox Content="Analisar o computador ao abrir o Clean Menu (só verifica, não apaga nada)" IsChecked="{Binding AnalyzeOnStartup}" Margin="0,14,0,0" />
        <CheckBox Content="Pedir confirmação antes de limpar (recomendado)" IsChecked="{Binding ConfirmBeforeCleaning}" Margin="0,14,0,0" />
        <TextBlock Text="Fechar programas, esvaziar a Lixeira e ferramentas de administrador sempre pedem confirmação."
                   Style="{StaticResource Text.Caption}" Margin="32,6,0,0" />
      </StackPanel>
    </Border>

    <TextBlock Text="O que vem marcado na Limpeza Inteligente" Style="{StaticResource Text.SectionTitle}" Margin="0,24,0,12" />
    <Border Style="{StaticResource SettingRow}">
      <ItemsControl ItemsSource="{Binding DefaultCategories}" Focusable="False">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type vm:DefaultCategoryOption}">
            <CheckBox Content="{Binding Title}" IsChecked="{Binding IsChecked}" Margin="0,6" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <TextBlock Text="Dados do Clean Menu" Style="{StaticResource Text.SectionTitle}" Margin="0,24,0,12" />
    <Border Style="{StaticResource SettingRow}">
      <DockPanel>
        <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Command="{Binding OpenDataFolderCommand}" VerticalAlignment="Center">
          <TextBlock Text="Abrir pasta" />
        </Button>
        <StackPanel Margin="0,0,16,0">
          <TextBlock Text="Configurações, histórico e registros" Style="{StaticResource Text.CardTitle}" />
          <TextBlock Text="{Binding DataFolder}" Style="{StaticResource Text.Caption}" FontSize="14" Margin="0,4,0,0" />
        </StackPanel>
      </DockPanel>
    </Border>
  </StackPanel>
</UserControl>
