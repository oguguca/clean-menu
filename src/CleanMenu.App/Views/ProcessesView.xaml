<UserControl x:Class="CleanMenu.App.Views.ProcessesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CleanMenu.UI.Controls;assembly=CleanMenu.UI"
             xmlns:ui="clr-namespace:CleanMenu.UI;assembly=CleanMenu.UI"
             xmlns:vm="clr-namespace:CleanMenu.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProcessesViewModel}"
             Style="{StaticResource Page.Root}">
  <StackPanel>
    <controls:PageHeader Title="{Binding Title}" Description="{Binding Description}" />

    <!-- Toolbar: search, sort, refresh -->
    <DockPanel Margin="0,28,14,12">
      <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Command="{Binding RefreshCommand}" Margin="12,0,0,0"
              ToolTip="Lê a lista de novo agora. Ela também se atualiza sozinha.">
        <TextBlock Text="Atualizar" />
      </Button>
      <Border DockPanel.Dock="Right" Style="{StaticResource SegmentGroup}" Margin="12,0,0,0">
        <StackPanel Orientation="Horizontal">
          <RadioButton Style="{StaticResource Segment}" Content="Memória" GroupName="ProcSort"
                       IsChecked="{Binding SortMode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:ProcessSortMode.Memory}}" />
          <RadioButton Style="{StaticResource Segment}" Content="Processador" GroupName="ProcSort"
                       IsChecked="{Binding SortMode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:ProcessSortMode.Cpu}}" />
          <RadioButton Style="{StaticResource Segment}" Content="Nome" GroupName="ProcSort"
                       IsChecked="{Binding SortMode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:ProcessSortMode.Name}}" />
        </StackPanel>
      </Border>
      <TextBox Style="{StaticResource TextBox.Search}" Tag="Procurar pelo nome do programa"
               Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=200}"
               AutomationProperties.Name="Procurar processo" />
    </DockPanel>

    <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Caption}" Margin="0,0,0,12" />

    <Border Style="{StaticResource Card}" Margin="0,0,14,14" Padding="16">
      <DockPanel>
        <TextBlock Text="{x:Static ui:Glyphs.Info}" Style="{StaticResource Text.Icon}" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,12,0" VerticalAlignment="Top" />
        <TextBlock Style="{StaticResource Text.Secondary}"
                   Text="Nesta versão você pode ver o que está rodando. A opção de fechar programas com segurança (sem deixar fechar o que é do Windows) chega em breve." />
      </DockPanel>
    </Border>

    <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="8">
      <DockPanel>
        <!-- Column headers -->
        <Grid DockPanel.Dock="Top" Margin="12,8,22,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="100" />
            <ColumnDefinition Width="110" />
          </Grid.ColumnDefinitions>
          <TextBlock Text="PROGRAMA" Style="{StaticResource Text.GroupLabel}" />
          <TextBlock Grid.Column="1" Text="TIPO" Style="{StaticResource Text.GroupLabel}" />
          <TextBlock Grid.Column="2" Text="PROCESSADOR" Style="{StaticResource Text.GroupLabel}" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="3" Text="MEMÓRIA" Style="{StaticResource Text.GroupLabel}" HorizontalAlignment="Right" />
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Brush.Border}" Margin="8,0" />

        <ListBox ItemsSource="{Binding Rows}" Height="560" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource Row.Item}"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="Lista de processos">
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:ProcessRowViewModel}">
              <Grid ToolTip="{Binding Advice}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="170" />
                  <ColumnDefinition Width="100" />
                  <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                  <TextBlock Text="{Binding Pid, StringFormat='  · PID {0}'}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding KindText}" Style="{StaticResource Text.Caption}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding CpuText}" HorizontalAlignment="Right" />
                <TextBlock Grid.Column="3" Text="{Binding MemoryText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
  </StackPanel>
</UserControl>
