<UserControl x:Class="CleanMenu.App.Views.NetworkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CleanMenu.UI.Controls;assembly=CleanMenu.UI"
             xmlns:ui="clr-namespace:CleanMenu.UI;assembly=CleanMenu.UI"
             xmlns:vm="clr-namespace:CleanMenu.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:NetworkViewModel}"
             x:Name="Root"
             Style="{StaticResource Page.Root}">
  <StackPanel>
    <controls:PageHeader Title="{Binding Title}" Description="{Binding Description}" />

    <Border Margin="0,20,14,0" Padding="14,12" CornerRadius="8" Background="{DynamicResource Brush.AccentSubtle}"
            Visibility="{Binding Message, Converter={StaticResource HasValue}}">
      <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" />
    </Border>

    <!-- ===== Tests ===== -->
    <UniformGrid Columns="2" Margin="0,24,0,0">
      <!-- Ping -->
      <Border Style="{StaticResource Card}" Margin="0,0,14,14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Testar a conexão (ping)" Style="{StaticResource Text.CardTitle}" />
            <controls:InfoTip Margin="8,0,0,0" Text="Envia 4 sinais para um site e mede quanto tempo a resposta leva. Mostra se a internet está funcionando e se está estável." />
          </StackPanel>
          <TextBlock Text="Endereço para testar" Style="{StaticResource Fact.Label}" Margin="0,14,0,4" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Command="{Binding PingCommand}" Margin="10,0,0,0">
              <TextBlock Text="Testar" />
            </Button>
            <TextBox Style="{StaticResource TextBox.Input}" Text="{Binding PingHost, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Endereço para testar" />
          </DockPanel>
          <TextBlock Text="{Binding PingResult}" Style="{StaticResource Text.Body}" Margin="0,12,0,0" TextWrapping="Wrap"
                     Visibility="{Binding PingResult, Converter={StaticResource HasValue}}" />
        </StackPanel>
      </Border>

      <!-- Speed -->
      <Border Style="{StaticResource Card}" Margin="0,0,14,14">
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="Testar a velocidade da internet" Style="{StaticResource Text.CardTitle}" />
            <controls:InfoTip Margin="8,0,0,0" Text="Baixa e envia dados de teste para um servidor público e mede a velocidade real. Nenhum dado seu é enviado." />
          </StackPanel>
          <TextBlock Style="{StaticResource Text.Caption}" Margin="0,6,0,0" TextWrapping="Wrap">
            <Run Text="Servidor:" /> <Run Text="{Binding SpeedServer, Mode=OneWay}" /><Run Text=". " /><Run Text="{Binding SpeedDataText, Mode=OneWay}" />
          </TextBlock>
          <Button Style="{StaticResource Button.Primary}" HorizontalAlignment="Left" Command="{Binding SpeedTestCommand}" Margin="0,12,0,0">
            <TextBlock Text="Iniciar teste" />
          </Button>
          <TextBlock Text="{Binding SpeedProgress}" Style="{StaticResource Text.Secondary}" Margin="0,10,0,0"
                     Visibility="{Binding SpeedProgress, Converter={StaticResource HasValue}}" />
          <UniformGrid Columns="3" Margin="0,12,0,0" Visibility="{Binding DownloadSpeed, Converter={StaticResource HasValue}}">
            <StackPanel>
              <TextBlock Text="Download" Style="{StaticResource Fact.Label}" />
              <TextBlock Text="{Binding DownloadSpeed}" FontSize="20" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Upload" Style="{StaticResource Fact.Label}" />
              <TextBlock Text="{Binding UploadSpeed}" FontSize="20" FontWeight="SemiBold" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="Resposta" Style="{StaticResource Fact.Label}" />
              <TextBlock Text="{Binding Latency}" FontSize="20" FontWeight="SemiBold" />
            </StackPanel>
          </UniformGrid>
          <TextBlock Text="{Binding SpeedNote}" Style="{StaticResource Text.Caption}" Margin="0,10,0,0" TextWrapping="Wrap"
                     Visibility="{Binding SpeedNote, Converter={StaticResource HasValue}}" />
        </StackPanel>
      </Border>
    </UniformGrid>

    <!-- ===== Repair ===== -->
    <Border Style="{StaticResource Card}" Margin="0,0,14,0">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource Button.Secondary}" Command="{Binding OpenNetworkConnectionsCommand}" Margin="0,0,10,0">
            <TextBlock Text="Abrir Conexões de Rede" />
          </Button>
          <Button Style="{StaticResource Button.Secondary}" Command="{Binding ResetNetworkCommand}">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{x:Static ui:Glyphs.Repair}" Style="{StaticResource Text.Icon}" FontSize="14" Margin="0,0,8,0" />
              <TextBlock Text="Consertar a internet" />
            </StackPanel>
          </Button>
        </StackPanel>
        <StackPanel Margin="0,0,16,0">
          <TextBlock Text="A internet parou de funcionar?" Style="{StaticResource Text.CardTitle}" />
          <TextBlock Style="{StaticResource Text.Caption}" FontSize="14" Margin="0,4,0,0" TextWrapping="Wrap"
                     Text="Reinicia as configurações de rede do Windows (DNS, Winsock e TCP/IP). Mostra os comandos antes e pede confirmação. Depois é preciso reiniciar o computador." />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ===== Adapters (ipconfig) ===== -->
    <DockPanel Margin="0,28,14,4">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Style="{StaticResource Button.Ghost}" Command="{Binding RefreshCommand}" Margin="0,0,8,0">
          <TextBlock Text="Atualizar" />
        </Button>
        <Button Style="{StaticResource Button.Ghost}" Command="{Binding CopyAdaptersCommand}">
          <TextBlock Text="Copiar tudo" />
        </Button>
      </StackPanel>
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="Conexões de rede e endereços IP" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center" />
        <controls:InfoTip Margin="8,0,0,0" Text="As mesmas informações do comando ipconfig: endereço IP, gateway (roteador) e servidores DNS de cada placa de rede." />
      </StackPanel>
    </DockPanel>
    <CheckBox IsChecked="{Binding ShowAllAdapters}" Margin="0,4,0,12">
      <TextBlock Text="{Binding HiddenAdapters, StringFormat='Mostrar também as desconectadas e virtuais ({0} escondidas)'}" />
    </CheckBox>
    <ItemsControl ItemsSource="{Binding Adapters}" Focusable="False">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="2" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:NetworkAdapterRowViewModel}">
          <Border Style="{StaticResource Card}" Margin="0,0,14,14">
            <StackPanel>
              <DockPanel>
                <Border DockPanel.Dock="Right" Style="{StaticResource Tag.Border}">
                  <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" />
                </Border>
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.CardTitle}" TextTrimming="CharacterEllipsis" />
              </DockPanel>
              <TextBlock Style="{StaticResource Text.Caption}" Margin="0,2,0,10" TextTrimming="CharacterEllipsis">
                <Run Text="{Binding KindText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Description, Mode=OneWay}" />
              </TextBlock>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="2*" />
                  <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Endereço IP (IPv4)" Style="{StaticResource Text.Caption}" Margin="0,3" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding IPv4Text}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3" />
                <TextBlock Grid.Row="1" Text="Roteador (gateway)" Style="{StaticResource Text.Caption}" Margin="0,3" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding GatewayText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3" />
                <TextBlock Grid.Row="2" Text="Servidores DNS" Style="{StaticResource Text.Caption}" Margin="0,3" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DnsText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3" />
                <TextBlock Grid.Row="3" Text="Velocidade da placa" Style="{StaticResource Text.Caption}" Margin="0,3" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SpeedText}" FontWeight="SemiBold" Margin="0,3" />
                <TextBlock Grid.Row="4" Text="Configuração" Style="{StaticResource Text.Caption}" Margin="0,3" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding DhcpText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3" />
                <TextBlock Grid.Row="5" Text="Endereço físico (MAC)" Style="{StaticResource Text.Caption}" Margin="0,3" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding MacText}" FontWeight="SemiBold" Margin="0,3" />
                <TextBlock Grid.Row="6" Text="IPv6" Style="{StaticResource Text.Caption}" Margin="0,3" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding IPv6Text}" TextWrapping="Wrap" Margin="0,3" Foreground="{DynamicResource Brush.TextSecondary}" />
              </Grid>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- ===== Download ===== -->
    <StackPanel Orientation="Horizontal" Margin="0,28,0,4">
      <TextBlock Text="Baixar um arquivo (HTTPS)" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center" />
      <controls:InfoTip Margin="8,0,0,0" Text="Baixa um arquivo de um endereço seguro (https://) e mostra o código SHA-256 para você conferir com o código informado no site." />
    </StackPanel>
    <TextBlock Style="{StaticResource Text.Caption}" Margin="0,0,14,12" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Warning}"
               Text="Só baixe arquivos de sites que você conhece e confia. Programas (.exe, .msi) de sites desconhecidos podem conter vírus. O Clean Menu nunca abre o arquivo sozinho." />
    <Border Style="{StaticResource Card}" Margin="0,0,14,0">
      <StackPanel>
        <TextBlock Text="Endereço do arquivo" Style="{StaticResource Fact.Label}" Margin="0,0,0,4" />
        <DockPanel>
          <Button DockPanel.Dock="Right" Style="{StaticResource Button.Primary}" Command="{Binding DownloadCommand}" Margin="10,0,0,0">
            <TextBlock Text="Baixar" />
          </Button>
          <TextBox Style="{StaticResource TextBox.Input}" Tag="https://exemplo.com/arquivo.zip" Text="{Binding DownloadUrl, UpdateSourceTrigger=PropertyChanged}"
                   AutomationProperties.Name="Endereço do arquivo" />
        </DockPanel>

        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Command="{Binding CancelDownloadCommand}" Padding="14,6">
              <TextBlock Text="Cancelar" />
            </Button>
            <ContentControl />
          </DockPanel>
          <controls:UsageBar Value="{Binding DownloadPercent}" Margin="0,8,0,0" TrackBrush="{DynamicResource Brush.Track}" FillBrush="{DynamicResource Brush.Accent}" />
        </StackPanel>

        <TextBlock Text="{Binding DownloadStatus}" Style="{StaticResource Text.Body}" Margin="0,12,0,0" TextWrapping="Wrap"
                   Visibility="{Binding DownloadStatus, Converter={StaticResource HasValue}}" />

        <StackPanel Margin="0,12,0,0" Visibility="{Binding DownloadedPath, Converter={StaticResource HasValue}}">
          <TextBlock Text="Código SHA-256 (para conferir com o site)" Style="{StaticResource Fact.Label}" />
          <TextBox Text="{Binding DownloadedHash, Mode=OneWay}" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                   Foreground="{DynamicResource Brush.Text}" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,4,0,8" />
          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource Button.Secondary}" Command="{Binding ShowDownloadedCommand}" Margin="0,0,10,0">
              <TextBlock Text="Mostrar na pasta" />
            </Button>
            <Button Style="{StaticResource Button.Ghost}" Command="{Binding CopyHashCommand}">
              <TextBlock Text="Copiar código" />
            </Button>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
