<UserControl x:Class="CleanMenu.App.Views.AdvancedCleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CleanMenu.UI.Controls;assembly=CleanMenu.UI"
             xmlns:ui="clr-namespace:CleanMenu.UI;assembly=CleanMenu.UI"
             xmlns:vm="clr-namespace:CleanMenu.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AdvancedCleanupViewModel}"
             x:Name="Root"
             Style="{StaticResource Page.Root}">
  <UserControl.Resources>
    <DataTemplate x:Key="FileRow" DataType="{x:Type vm:SelectableFileViewModel}">
      <Grid Margin="0,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="{Binding Name}" />
        <StackPanel Grid.Column="1">
          <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Folder}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
          <TextBlock Text="{Binding DateText}" Style="{StaticResource Text.Caption}" Foreground="{DynamicResource Brush.TextMuted}" />
        </StackPanel>
        <Button Grid.Column="2" Style="{StaticResource Button.Ghost}" Margin="8,0" VerticalAlignment="Center"
                Command="{Binding DataContext.ShowInFolderCommand, ElementName=Root}" CommandParameter="{Binding}">
          <TextBlock Text="Mostrar na pasta" />
        </Button>
        <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontWeight="SemiBold" VerticalAlignment="Center" MinWidth="80" TextAlignment="Right" />
      </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <StackPanel>
    <controls:PageHeader Title="{Binding Title}" Description="{Binding Description}" />

    <!-- What to look for -->
    <Border Style="{StaticResource SegmentGroup}" HorizontalAlignment="Left" Margin="0,28,0,0">
      <StackPanel Orientation="Horizontal">
        <RadioButton Style="{StaticResource Segment}" Content="Arquivos grandes" GroupName="AdvMode"
                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:AdvancedMode.LargeFiles}}" />
        <RadioButton Style="{StaticResource Segment}" Content="Duplicados" GroupName="AdvMode"
                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:AdvancedMode.Duplicates}}" />
        <RadioButton Style="{StaticResource Segment}" Content="Pastas que mais ocupam" GroupName="AdvMode"
                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:AdvancedMode.Folders}}" />
        <RadioButton Style="{StaticResource Segment}" Content="Sobras de programas" GroupName="AdvMode"
                     IsChecked="{Binding Mode, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:AdvancedMode.Leftovers}}" />
      </StackPanel>
    </Border>
    <TextBlock Text="{Binding ModeHint}" Style="{StaticResource Text.Secondary}" Margin="0,12,14,0" />

    <!-- Where to look -->
    <Border Style="{StaticResource Card}" Margin="0,18,14,0" Padding="20">
      <StackPanel>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button Style="{StaticResource Button.Secondary}" Command="{Binding ChooseFolderCommand}" Margin="0,0,10,0">
              <TextBlock Text="Escolher pasta" />
            </Button>
            <Button Style="{StaticResource Button.Primary}" Command="{Binding ScanCommand}" Padding="22,10">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{x:Static ui:Glyphs.Search}" Style="{StaticResource Text.Icon}" FontSize="14" Margin="0,0,8,0" />
                <TextBlock Text="Procurar" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
            <TextBlock Text="Pasta analisada" Style="{StaticResource Fact.Label}" />
            <TextBlock Text="{Binding ScanRoot}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DockPanel>
        <CheckBox Margin="0,14,0,0" IsChecked="{Binding AllowDownloads}">
          <TextBlock Text="{Binding DownloadsFolder, StringFormat='Permitir analisar a pasta Downloads ({0})'}" />
        </CheckBox>
        <TextBlock Text="Pastas do Windows e de programas instalados nunca são analisadas aqui." Style="{StaticResource Text.Caption}" Margin="32,6,0,0" />

        <StackPanel Margin="0,16,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Command="{Binding CancelCommand}" Padding="14,6">
              <TextBlock Text="Cancelar" />
            </Button>
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
          </DockPanel>
          <controls:UsageBar Value="{Binding ProgressPercent}" Margin="0,10,0,0" TrackBrush="{DynamicResource Brush.Track}" FillBrush="{DynamicResource Brush.Accent}" />
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Margin="0,16,14,0" Padding="14,12" CornerRadius="8" Background="{DynamicResource Brush.AccentSubtle}"
            Visibility="{Binding Message, Converter={StaticResource HasValue}}">
      <TextBlock Text="{Binding Message}" Style="{StaticResource Text.Body}" />
    </Border>

    <!-- Selection actions (files and duplicates) -->
    <DockPanel Margin="0,20,14,10">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Style="{StaticResource Button.Ghost}" Command="{Binding MarkDuplicateCopiesCommand}" Margin="0,0,8,0"
                Visibility="{Binding ShowsDuplicates, Converter={StaticResource BoolToVisibility}}"
                ToolTip="Em cada grupo, marca todas as cópias menos a mais antiga.">
          <TextBlock Text="Marcar cópias (manter a mais antiga)" />
        </Button>
        <Button Style="{StaticResource Button.Secondary}" Command="{Binding RecycleSelectedCommand}">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{x:Static ui:Glyphs.Delete}" Style="{StaticResource Text.Icon}" FontSize="14" Margin="0,0,8,0" />
            <TextBlock Text="Mandar para a Lixeira" />
          </StackPanel>
        </Button>
      </StackPanel>
      <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" VerticalAlignment="Center" />
    </DockPanel>

    <!-- Large files -->
    <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="18,10"
            Visibility="{Binding Files.Count, Converter={StaticResource HasValue}}">
      <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource FileRow}" Focusable="False" />
    </Border>

    <!-- Duplicates -->
    <ItemsControl ItemsSource="{Binding Duplicates}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:DuplicateGroupViewModel}">
          <Border Style="{StaticResource Card}" Margin="0,0,14,10" Padding="18,12">
            <StackPanel>
              <TextBlock Text="{Binding Title}" Style="{StaticResource Text.CardTitle}" Margin="0,0,0,6" />
              <ItemsControl ItemsSource="{Binding Files}" ItemTemplate="{StaticResource FileRow}" Focusable="False" />
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- Folders and leftovers -->
    <ItemsControl ItemsSource="{Binding Folders}" Focusable="False">
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:FolderRowViewModel}">
          <Border Style="{StaticResource Card}" Margin="0,0,14,10" Padding="18,12">
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" VerticalAlignment="Center"
                      Command="{Binding DataContext.OpenFolderCommand, ElementName=Root}" CommandParameter="{Binding Path}">
                <TextBlock Text="Abrir pasta" />
              </Button>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{Binding Title}" Style="{StaticResource Text.CardTitle}" />
                <TextBlock Text="{Binding Detail}" Style="{StaticResource Text.Caption}" Margin="0,3,0,6" TextTrimming="CharacterEllipsis" />
                <controls:UsageBar Value="{Binding Percent}" TrackBrush="{DynamicResource Brush.Track}" FillBrush="{DynamicResource Brush.Accent}" Height="6" />
              </StackPanel>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
