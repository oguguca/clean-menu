<UserControl x:Class="CleanMenu.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CleanMenu.UI.Controls;assembly=CleanMenu.UI"
             xmlns:ui="clr-namespace:CleanMenu.UI;assembly=CleanMenu.UI"
             xmlns:vm="clr-namespace:CleanMenu.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             Style="{StaticResource Page.Root}">
  <StackPanel>
    <controls:PageHeader Title="{Binding Title}" Description="{Binding Description}" />

    <!-- ===== Main action: one obvious button ===== -->
    <Border Style="{StaticResource Card}" Margin="0,28,14,0" Padding="28">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="0,0,32,0">
          <TextBlock Text="{Binding AnalysisHeadline}" Style="{StaticResource Text.SectionTitle}" FontSize="22" />
          <TextBlock Text="{Binding AnalysisHint}" Style="{StaticResource Text.Secondary}" Margin="0,8,0,22" MaxWidth="560" HorizontalAlignment="Left" />

          <StackPanel Orientation="Horizontal">
            <Button Style="{StaticResource Button.Primary}" Command="{Binding AnalyzeCommand}" HorizontalAlignment="Left"
                    AutomationProperties.Name="Analisar meu computador"
                    ToolTip="Verifica o computador e mostra o que pode ser melhorado. Não apaga nada.">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{x:Static ui:Glyphs.Search}" Style="{StaticResource Text.Icon}" Margin="0,0,10,0" />
                <TextBlock Text="ANALISAR MEU COMPUTADOR" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource Button.Secondary}" Command="{Binding OpenCleanupCommand}" Margin="12,0,0,0"
                    Visibility="{Binding HasAnalysis, Converter={StaticResource BoolToVisibility}}"
                    ToolTip="Abre a Limpeza Inteligente com o resultado desta análise.">
              <TextBlock Text="Ver detalhes e limpar" />
            </Button>
            <Button Style="{StaticResource Button.Secondary}" Command="{Binding CancelAnalysisCommand}" Margin="12,0,0,0"
                    Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}">
              <TextBlock Text="Cancelar" />
            </Button>
          </StackPanel>

          <controls:UsageBar Value="{Binding AnalysisProgress}" Margin="0,16,0,0" MaxWidth="420" HorizontalAlignment="Left" Width="420"
                             TrackBrush="{DynamicResource Brush.Track}" FillBrush="{DynamicResource Brush.Accent}"
                             Visibility="{Binding IsAnalyzing, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- Health ring: empty until there is a real result; then colored by the measured state. -->
        <Grid Grid.Column="1" Width="150" Height="150" VerticalAlignment="Center"
              AutomationProperties.Name="{Binding HealthLabel, StringFormat='Saúde geral: {0}'}">
          <controls:RingGauge Value="{Binding HealthRingValue}" Thickness="12" Style="{StaticResource StatusRing}" />
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="{Binding HealthLabel}" Style="{StaticResource Text.Value}" FontSize="28" HorizontalAlignment="Center" />
            <TextBlock Text="Saúde" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- ===== Live ===== -->
    <TextBlock Text="Agora" Style="{StaticResource Text.SectionTitle}" Margin="0,36,0,4" />
    <TextBlock Text="Atualiza sozinho a cada 2 segundos." Style="{StaticResource Text.Caption}" Margin="0,0,0,14" />
    <ItemsControl ItemsSource="{Binding LiveCards}" Focusable="False">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="4" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>

    <!-- ===== Summary ===== -->
    <TextBlock Text="Resumo" Style="{StaticResource Text.SectionTitle}" Margin="0,22,0,4" />
    <TextBlock Text="Passe o mouse no ? de cada quadro para entender o que ele significa." Style="{StaticResource Text.Caption}" Margin="0,0,0,14" />
    <ItemsControl ItemsSource="{Binding SummaryCards}" Focusable="False">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="3" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>

    <!-- ===== Storage ===== -->
    <TextBlock Text="Espaço nos discos" Style="{StaticResource Text.SectionTitle}" Margin="0,22,0,14" />
    <ItemsControl ItemsSource="{Binding Volumes}" Focusable="False">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="2" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>

    <!-- ===== This computer ===== -->
    <TextBlock Text="Este computador" Style="{StaticResource Text.SectionTitle}" Margin="0,22,0,14" />
    <Border Style="{StaticResource Card}" Margin="0,0,14,0" Padding="20,20,20,4">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,16,0">
          <TextBlock Text="Nome do computador" Style="{StaticResource Fact.Label}" />
          <TextBlock Text="{Binding MachineName}" Style="{StaticResource Fact.Value}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Margin="0,0,16,0">
          <TextBlock Text="Sistema" Style="{StaticResource Fact.Label}" />
          <TextBlock Text="{Binding WindowsName}" Style="{StaticResource Fact.Value}" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Versão do Windows" Style="{StaticResource Fact.Label}" />
          <TextBlock Text="{Binding WindowsVersion}" Style="{StaticResource Fact.Value}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,0,16,0">
          <TextBlock Text="Processador" Style="{StaticResource Fact.Label}" />
          <TextBlock Text="{Binding ProcessorName}" Style="{StaticResource Fact.Value}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,16,0">
          <TextBlock Text="Memória RAM instalada" Style="{StaticResource Fact.Label}" />
          <TextBlock Text="{Binding InstalledMemory}" Style="{StaticResource Fact.Value}" />
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2">
          <TextBlock Text="Placa de vídeo" Style="{StaticResource Fact.Label}" />
          <TextBlock Text="{Binding GraphicsName}" Style="{StaticResource Fact.Value}" />
        </StackPanel>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
