<UserControl x:Class="CleanMenu.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CleanMenu.UI.Controls;assembly=CleanMenu.UI"
             xmlns:ui="clr-namespace:CleanMenu.UI;assembly=CleanMenu.UI"
             xmlns:vm="clr-namespace:CleanMenu.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}"
             Style="{StaticResource Page.Root}">
  <StackPanel>
    <controls:PageHeader Title="{Binding Title}" Description="{Binding Description}" />

    <!-- ===== Main action: one obvious button ===== -->
    <Border Style="{StaticResource Card}" Margin="0,28,0,0" Padding="28">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel VerticalAlignment="Center" Margin="0,0,32,0">
          <TextBlock Text="{Binding AnalysisHeadline}" Style="{StaticResource Text.SectionTitle}" FontSize="22" />
          <TextBlock Text="{Binding AnalysisHint}" Style="{StaticResource Text.Secondary}" Margin="0,8,0,22" MaxWidth="560" HorizontalAlignment="Left" />

          <Button Style="{StaticResource Button.Primary}" Command="{Binding AnalyzeCommand}" HorizontalAlignment="Left"
                  AutomationProperties.Name="Analisar meu computador"
                  ToolTip="Verifica o computador e mostra o que pode ser melhorado. Não apaga nada."
                  ToolTipService.ShowOnDisabled="True">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{x:Static ui:Glyphs.Search}" Style="{StaticResource Text.Icon}" Margin="0,0,10,0" />
              <TextBlock Text="ANALISAR MEU COMPUTADOR" />
            </StackPanel>
          </Button>

          <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsAnalysisAvailable}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="{x:Static ui:Glyphs.Info}" Style="{StaticResource Text.Icon}" FontSize="13"
                       Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,8,0" />
            <TextBlock Text="{Binding AnalysisUnavailableNote}" Style="{StaticResource Text.Caption}" />
          </StackPanel>
        </StackPanel>

        <!-- Health ring: stays empty until there is a real result. -->
        <Grid Grid.Column="1" Width="150" Height="150" VerticalAlignment="Center"
              AutomationProperties.Name="Saúde geral: ainda sem análise">
          <controls:RingGauge Thickness="12" TrackBrush="{DynamicResource Brush.Track}" ValueBrush="{DynamicResource Brush.Accent}" />
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="—" Style="{StaticResource Text.Value}" FontSize="32" HorizontalAlignment="Center" />
            <TextBlock Text="Saúde" Style="{StaticResource Text.Caption}" HorizontalAlignment="Center" />
          </StackPanel>
        </Grid>
      </Grid>
    </Border>

    <!-- ===== Summary ===== -->
    <TextBlock Text="Resumo" Style="{StaticResource Text.SectionTitle}" Margin="0,36,0,4" />
    <TextBlock Text="Passe o mouse no ? de cada quadro para entender o que ele significa." Style="{StaticResource Text.Caption}" Margin="0,0,0,14" />

    <ItemsControl ItemsSource="{Binding SummaryCards}" Focusable="False">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <UniformGrid Columns="3" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:SummaryCardModel}">
          <controls:StatCard Margin="0,0,14,14" Title="{Binding Title}" Glyph="{Binding Glyph}" Value="{Binding Value}"
                             Caption="{Binding Caption}" HelpText="{Binding HelpText}" Status="{Binding Status}" />
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>

    <!-- ===== This computer: only facts that are already known ===== -->
    <TextBlock Text="Este computador" Style="{StaticResource Text.SectionTitle}" Margin="0,22,0,14" />
    <Border Style="{StaticResource Card}" Margin="0,0,14,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel>
          <TextBlock Text="Nome do computador" Style="{StaticResource Text.Caption}" />
          <TextBlock Text="{Binding MachineName}" Style="{StaticResource Text.CardTitle}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="1">
          <TextBlock Text="Sistema" Style="{StaticResource Text.Caption}" />
          <TextBlock Text="{Binding WindowsName}" Style="{StaticResource Text.CardTitle}" Margin="0,4,0,0" />
        </StackPanel>
        <StackPanel Grid.Column="2">
          <TextBlock Text="Versão do Windows" Style="{StaticResource Text.Caption}" />
          <TextBlock Text="{Binding WindowsBuild}" Style="{StaticResource Text.CardTitle}" Margin="0,4,0,0" />
        </StackPanel>
      </Grid>
    </Border>
    <TextBlock Text="Processador, memória e discos vão aparecer aqui em uma próxima versão."
               Style="{StaticResource Text.Caption}" Margin="0,10,0,0" />
  </StackPanel>
</UserControl>
