<UserControl x:Class="CleanMenu.App.Views.SmartCleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:CleanMenu.UI.Controls;assembly=CleanMenu.UI"
             xmlns:ui="clr-namespace:CleanMenu.UI;assembly=CleanMenu.UI"
             xmlns:vm="clr-namespace:CleanMenu.App.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SmartCleanupViewModel}"
             x:Name="Root"
             Style="{StaticResource Page.Root}">
  <UserControl.Resources>
    <CollectionViewSource x:Key="GroupedRows" Source="{Binding Rows}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="Group" />
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>
  </UserControl.Resources>

  <StackPanel>
    <controls:PageHeader Title="{Binding Title}" Description="{Binding Description}" />

    <!-- ===== Action bar ===== -->
    <Border Style="{StaticResource Card}" Margin="0,28,14,0" Padding="24">
      <StackPanel>
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource Button.Secondary}" Command="{Binding AnalyzeCommand}" Margin="0,0,10,0"
                    ToolTip="Procura arquivos que podem ser apagados. Não apaga nada.">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{x:Static ui:Glyphs.Search}" Style="{StaticResource Text.Icon}" FontSize="14" Margin="0,0,8,0" />
                <TextBlock Text="Analisar" />
              </StackPanel>
            </Button>
            <Button Style="{StaticResource Button.Primary}" Command="{Binding CleanCommand}" Padding="24,11"
                    ToolTipService.ShowOnDisabled="True"
                    ToolTip="Apaga os arquivos das categorias marcadas. Você confirma antes.">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{x:Static ui:Glyphs.Delete}" Style="{StaticResource Text.Icon}" FontSize="14" Margin="0,0,8,0" />
                <TextBlock Text="Limpar selecionados" />
              </StackPanel>
            </Button>
          </StackPanel>
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource Text.Body}" FontWeight="SemiBold" />
            <CheckBox Content="Modo simulação: mostra o que seria apagado, sem apagar nada" IsChecked="{Binding IsDryRun}" Margin="0,12,0,0" />
          </StackPanel>
        </DockPanel>

        <!-- Progress -->
        <StackPanel Margin="0,18,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Button.Secondary}" Command="{Binding CancelCommand}" Padding="14,6">
              <TextBlock Text="Cancelar" />
            </Button>
            <TextBlock Text="{Binding ProgressText}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" />
          </DockPanel>
          <controls:UsageBar Value="{Binding ProgressPercent}" Margin="0,10,0,0"
                             TrackBrush="{DynamicResource Brush.Track}" FillBrush="{DynamicResource Brush.Accent}" />
        </StackPanel>

        <!-- Result -->
        <Border Margin="0,18,0,0" Padding="14,12" CornerRadius="8" Background="{DynamicResource Brush.AccentSubtle}"
                Visibility="{Binding ResultMessage, Converter={StaticResource HasValue}}">
          <DockPanel>
            <TextBlock Text="{x:Static ui:Glyphs.CheckMark}" Style="{StaticResource Text.Icon}" Margin="0,0,10,0"
                       Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Top" />
            <TextBlock Text="{Binding ResultMessage}" Style="{StaticResource Text.Body}" />
          </DockPanel>
        </Border>
      </StackPanel>
    </Border>

    <!-- ===== Selection shortcuts ===== -->
    <DockPanel Margin="0,24,14,8">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Style="{StaticResource Button.Ghost}" Command="{Binding SelectAllCommand}" Content="Selecionar tudo" />
        <Button Style="{StaticResource Button.Ghost}" Command="{Binding SelectNoneCommand}" Content="Desmarcar tudo" />
      </StackPanel>
      <TextBlock Text="O que limpar" Style="{StaticResource Text.SectionTitle}" VerticalAlignment="Center" />
    </DockPanel>

    <!-- ===== Categories ===== -->
    <ItemsControl ItemsSource="{Binding Source={StaticResource GroupedRows}}" Focusable="False">
      <ItemsControl.GroupStyle>
        <GroupStyle>
          <GroupStyle.HeaderTemplate>
            <DataTemplate>
              <TextBlock Text="{Binding Name}" Style="{StaticResource Text.GroupLabel}" Margin="4,14,0,8" />
            </DataTemplate>
          </GroupStyle.HeaderTemplate>
        </GroupStyle>
      </ItemsControl.GroupStyle>
      <ItemsControl.ItemTemplate>
        <DataTemplate DataType="{x:Type vm:CleanupCategoryRowViewModel}">
          <Border Style="{StaticResource Card}" Margin="0,0,14,10" Padding="18,16">
            <StackPanel>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="120" />
                  <ColumnDefinition Width="130" />
                  <ColumnDefinition Width="130" />
                </Grid.ColumnDefinitions>

                <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" VerticalAlignment="Top" Margin="0,2,14,0"
                          AutomationProperties.Name="{Binding Title}" />
                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                  <TextBlock Text="{Binding Title}" Style="{StaticResource Text.CardTitle}" />
                  <TextBlock Text="{Binding Description}" Style="{StaticResource Text.Caption}" Margin="0,4,0,0" FontSize="14" />
                  <TextBlock Text="{Binding NoteText}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                             Foreground="{DynamicResource Brush.TextMuted}"
                             Visibility="{Binding NoteText, Converter={StaticResource HasValue}}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                  <TextBlock Text="Para apagar" Style="{StaticResource Fact.Label}" />
                  <TextBlock Text="{Binding CountText}" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="3">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Ocupando" Style="{StaticResource Fact.Label}" VerticalAlignment="Center" />
                    <controls:InfoTip Margin="4,0,0,0" Text="Espaço usado por tudo o que existe nessa categoria." />
                  </StackPanel>
                  <TextBlock Text="{Binding OccupiedText}" FontWeight="SemiBold" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Pode liberar" Style="{StaticResource Fact.Label}" VerticalAlignment="Center" />
                    <controls:InfoTip Margin="4,0,0,0" Text="Espaço que pode ser liberado com segurança. Arquivos muito recentes ou protegidos não entram nessa conta." />
                  </StackPanel>
                  <TextBlock Text="{Binding RecoverableText}" FontWeight="SemiBold" Margin="0,3,0,0" Foreground="{DynamicResource Brush.Accent}" />
                </StackPanel>
              </Grid>

              <!-- Preview of what would be removed -->
              <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Left" Margin="26,8,0,0" Padding="10,6"
                      Command="{Binding DataContext.TogglePreviewCommand, ElementName=Root}" CommandParameter="{Binding}"
                      Visibility="{Binding HasPreview, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="Ver arquivos que serão apagados" Foreground="{DynamicResource Brush.Accent}" />
              </Button>
              <Border Margin="36,6,0,0" Padding="12" CornerRadius="8" Background="{DynamicResource Brush.Background}"
                      Visibility="{Binding IsPreviewOpen, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                  <ItemsControl ItemsSource="{Binding PreviewFiles}" Focusable="False" MaxHeight="260">
                    <ItemsControl.Template>
                      <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                          <ItemsPresenter />
                        </ScrollViewer>
                      </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type vm:PreviewFile}">
                        <DockPanel Margin="0,2">
                          <TextBlock DockPanel.Dock="Right" Text="{Binding SizeText}" Style="{StaticResource Text.Caption}" Margin="12,0,8,0" />
                          <TextBlock Text="{Binding Path}" Style="{StaticResource Text.Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                     ToolTip="{Binding Path}" />
                        </DockPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{Binding PreviewMoreText}" Style="{StaticResource Text.Caption}" Margin="0,6,0,0"
                             Visibility="{Binding PreviewMoreText, Converter={StaticResource HasValue}}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
