<Window x:Class="CleanMenu.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:CleanMenu.UI;assembly=CleanMenu.UI"
        xmlns:vm="clr-namespace:CleanMenu.App.ViewModels"
        xmlns:views="clr-namespace:CleanMenu.App.Views"
        xmlns:nav="clr-namespace:CleanMenu.App.Navigation"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Clean Menu"
        Width="1280" Height="840"
        MinWidth="1040" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Background}"
        Foreground="{DynamicResource Brush.Text}"
        FontFamily="{StaticResource Font.Text}"
        FontSize="14"
        UseLayoutRounding="True">
  <Window.Resources>
    <!-- Which view shows which page. -->
    <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
      <views:DashboardView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SectionPlaceholderViewModel}">
      <views:SectionPlaceholderView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:MemoryViewModel}">
      <views:MemoryView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:ProcessesViewModel}">
      <views:ProcessesView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SystemInfoViewModel}">
      <views:SystemInfoView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:DisksViewModel}">
      <views:DisksView />
    </DataTemplate>

    <CollectionViewSource x:Key="NavItems" Source="{Binding Items}">
      <CollectionViewSource.GroupDescriptions>
        <PropertyGroupDescription PropertyName="Group" />
      </CollectionViewSource.GroupDescriptions>
    </CollectionViewSource>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="288" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ===== Sidebar ===== -->
    <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
      <DockPanel Margin="14,20,14,16">

        <!-- Brand -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,0,12">
          <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource Brush.Accent}">
            <TextBlock Text="{x:Static ui:Glyphs.CheckMark}" Style="{StaticResource Text.Icon}" FontSize="17"
                       HorizontalAlignment="Center" Foreground="{DynamicResource Brush.OnAccent}" />
          </Border>
          <TextBlock Text="Clean Menu" FontFamily="{StaticResource Font.Display}" FontSize="19" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="12,0,0,0" />
        </StackPanel>

        <!-- Footer: which Windows the app is adapted to. Click to go to Settings. -->
        <StackPanel DockPanel.Dock="Bottom">
          <Border Height="1" Background="{DynamicResource Brush.Border}" Margin="4,8,4,10" />
          <Button Style="{StaticResource Button.Ghost}" HorizontalAlignment="Stretch"
                  Command="{Binding NavigateToCommand}" CommandParameter="{x:Static nav:AppPage.Settings}"
                  ToolTip="O Clean Menu mostra só as funções que existem no seu Windows. Clique para conferir ou trocar."
                  AutomationProperties.Name="Sistema operacional. Abrir configurações">
            <DockPanel>
              <TextBlock Text="{x:Static ui:Glyphs.Laptop}" Style="{StaticResource Text.Icon}" FontSize="18"
                         Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,0,12,0" />
              <StackPanel>
                <TextBlock Text="{Binding OsName}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding OsOrigin}" Style="{StaticResource Text.Caption}" FontSize="12" />
              </StackPanel>
            </DockPanel>
          </Button>
          <TextBlock Text="{Binding AppVersion}" Style="{StaticResource Text.Caption}" FontSize="12"
                     Foreground="{DynamicResource Brush.TextMuted}" Margin="12,8,0,0" />
        </StackPanel>

        <!-- Sections -->
        <ListBox ItemsSource="{Binding Source={StaticResource NavItems}}"
                 SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                 Style="{StaticResource Nav.List}"
                 ItemContainerStyle="{StaticResource Nav.Item}"
                 AutomationProperties.Name="Seções do Clean Menu">
          <ListBox.GroupStyle>
            <GroupStyle>
              <GroupStyle.HeaderTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding Name}" Style="{StaticResource Text.GroupLabel}" Margin="12,12,0,4" />
                </DataTemplate>
              </GroupStyle.HeaderTemplate>
            </GroupStyle>
          </ListBox.GroupStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:NavigationItem}">
              <DockPanel ToolTip="{Binding Description}" ToolTipService.Placement="Right" ToolTipService.InitialShowDelay="500"
                         Background="Transparent">
                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Text.Icon}" Width="20" Margin="0,0,12,0" />
                <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" VerticalAlignment="Center"
                        BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                        Visibility="{Binding IsAdvanced, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="Avançado" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource Brush.TextMuted}" />
                </Border>
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ===== Page content ===== -->
    <ScrollViewer x:Name="PageScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
      <!-- Content stretches up to 1180px and stays left-aligned on wide screens. -->
      <Grid Margin="44,36,30,44">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" MaxWidth="1180" />
        </Grid.ColumnDefinitions>
        <ContentControl Content="{Binding CurrentPage}" Focusable="False" />
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
