<Window x:Class="CleanMenu.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Clean Menu"
        Width="1200" Height="760"
        MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="#16181D">
    <!-- Placeholder shell. The real interface (sidebar, dashboard, theme) is built in Etapa 2. -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Clean Menu" FontSize="28" FontWeight="SemiBold" Foreground="#F2F3F5"
                   HorizontalAlignment="Center" />
        <TextBlock x:Name="OsText" Margin="0,8,0,0" FontSize="14" Foreground="#9AA0AA"
                   HorizontalAlignment="Center" />
        <TextBlock Margin="0,4,0,0" FontSize="12" Foreground="#6B717C" HorizontalAlignment="Center"
                   Text="Versão de arquitetura. Nenhuma funcionalidade disponível ainda." />
    </StackPanel>
</Window>
