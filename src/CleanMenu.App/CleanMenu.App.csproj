<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>CleanMenu.App</RootNamespace>
    <AssemblyName>CleanMenu</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Icon of the .exe (Explorer, taskbar, shortcuts). -->
    <ApplicationIcon>..\..\assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\app.ico" Link="Assets\app.ico" />
    <Resource Include="..\..\assets\icon.png" Link="Assets\icon.png" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CleanMenu.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CleanMenu.Core\CleanMenu.Core.csproj" />
    <ProjectReference Include="..\CleanMenu.Infrastructure\CleanMenu.Infrastructure.csproj" />
    <ProjectReference Include="..\CleanMenu.UI\CleanMenu.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
  </ItemGroup>

</Project>
