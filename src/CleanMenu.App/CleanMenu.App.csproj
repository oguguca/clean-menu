<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>CleanMenu.App</RootNamespace>
    <AssemblyName>CleanMenu</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="CleanMenu.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CleanMenu.Core\CleanMenu.Core.csproj" />
    <ProjectReference Include="..\CleanMenu.Infrastructure\CleanMenu.Infrastructure.csproj" />
    <ProjectReference Include="..\CleanMenu.UI\CleanMenu.UI.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.15" />
  </ItemGroup>

</Project>
